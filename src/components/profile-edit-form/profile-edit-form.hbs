<form class="profile-form" action="#" method="post" novalidate>
    {{#each fields}}
        {{{InlineFormField
            label=label
            name=name
            type=type
            value=value
            validationRule=validationRule
            formErrors=../formErrors
            formValues=../formValues
        }}}
    {{/each}}

    {{#if submitError}}
        <p class="profile-form__submit-error">{{submitError}}</p>
    {{/if}}

    {{{SubmitButton
        text=submitText
        className="profile-form__submit"
        disabled=isLoading
        isLoading=isLoading
        loadingText="Сохраняем..."
    }}}
</form>
