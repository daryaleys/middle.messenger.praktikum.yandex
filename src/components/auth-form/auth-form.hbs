<form class="auth-form" action="#" method="post" novalidate>
    <div class="auth-form__fields {{fieldsModifier}}">
        {{#each fields}}
            {{{FormField
                label=label
                name=name
                type=type
                validationRule=validationRule
                formErrors=../formErrors
                value=(fieldValue ../formValues name)
            }}}
        {{/each}}
    </div>

    <div class="auth-form__footer">
        {{#if submitError}}
            <p class="auth-form__submit-error">{{submitError}}</p>
        {{/if}}
        {{{SubmitButton
            text=submitText
            className="auth-form__submit"
            disabled=isLoading
            isLoading=isLoading
        }}}
        <a class="auth-form__link" href="{{linkHref}}">{{linkText}}</a>
    </div>
</form>
