<nav class="profile__actions" aria-label="Действия профиля">
    <ul class="profile__action-list">
        {{#each actions}}
            <li class="profile__action-item">
                {{#if isDanger}}
                    <button
                        class="profile__action profile__action--danger"
                        type="button"
                        ref="logoutButton"
                        {{#if ../isLoading}}disabled aria-busy="true"{{/if}}
                    >{{#if ../isLoading}}Выходим...{{else}}{{label}}{{/if}}</button>
                {{else}}
                    <a class="profile__action" href="{{href}}">{{label}}</a>
                {{/if}}
            </li>
        {{/each}}
    </ul>
    {{#if errorMessage}}
        <p class="profile__actions-error">{{errorMessage}}</p>
    {{/if}}
</nav>
