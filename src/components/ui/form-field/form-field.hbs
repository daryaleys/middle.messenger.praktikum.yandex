<div
    class="form-field"
    data-validation-field
    data-validation-state="{{#if isInvalid}}invalid{{else}}valid{{/if}}"
>
    {{{Input
        className="form-field__input"
        id=inputId
        type=type
        name=name
        value=(fieldValue formValues name)
        placeholder=" "
        validationRule=validationRule
        isInvalid=isInvalid
        describedBy=errorId
    }}}
    <label class="form-field__label" for="{{inputId}}">{{label}}</label>
    <span
        class="form-field__error"
        id="{{errorId}}"
        data-validation-error
        {{#unless errorMessage}}hidden{{/unless}}
    >{{errorMessage}}</span>
</div>
