<div
    class="auth-form__field"
    data-validation-field
    data-validation-state="{{#if isInvalid}}invalid{{else}}valid{{/if}}"
>
    {{{Input
        className="auth-form__input"
        id=inputId
        type=type
        name=name
        value=(fieldValue formValues name)
        placeholder=" "
        validationRule=validationRule
        isInvalid=isInvalid
        describedBy=errorId
    }}}
    <label class="auth-form__label" for="{{inputId}}">{{label}}</label>
    <span
        class="auth-form__error"
        id="{{errorId}}"
        data-validation-error
        {{#unless errorMessage}}hidden{{/unless}}
    >{{errorMessage}}</span>
</div>
