<div
    class="profile-form__field"
    data-validation-field
    data-validation-state="{{#if isInvalid}}invalid{{else}}valid{{/if}}"
>
    <label class="profile-form__label" for="{{inputId}}">{{label}}</label>
    {{{Input
        className="profile-form__input"
        id=inputId
        type=type
        name=name
        value=inputValue
        validationRule=validationRule
        isInvalid=isInvalid
        describedBy=errorId
    }}}
    <span
        class="profile-form__error"
        id="{{errorId}}"
        data-validation-error
        {{#unless errorMessage}}hidden{{/unless}}
    >{{errorMessage}}</span>
</div>
