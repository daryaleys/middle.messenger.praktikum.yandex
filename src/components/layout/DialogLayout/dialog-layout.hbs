{{#with activeChat}}
  <section class="dialog" aria-label="Открытый диалог">
    <header class="dialog-header">
      <span class="dialog-header__avatar" aria-hidden="true"></span>
      <h1 class="dialog-header__title">{{title}}</h1>
      <div class="dialog-header__actions">
        <button
          class="dialog-header__menu"
          type="button"
          aria-label="Открыть меню диалога"
          aria-expanded="false"
          aria-controls="{{../chatActionsDropdown.id}}"
          data-chat-actions-trigger
        >
          <svg class="dialog-header__menu-icon" viewBox="0 0 128 512" aria-hidden="true">
            <path d="M64 360a56 56 0 1 0 0 112 56 56 0 1 0 0-112zm0-160a56 56 0 1 0 0 112 56 56 0 1 0 0-112zM120 96A56 56 0 1 0 8 96a56 56 0 1 0 112 0z" />
          </svg>
        </button>

        {{{Dropdown
          config=../chatActionsDropdown
          triggerSelector="[data-chat-actions-trigger]"
        }}}
      </div>
    </header>

    <div class="dialog-messages">
      {{#if date}}
        <time class="dialog-date">{{date}}</time>
      {{/if}}

      {{#each messages}}
        {{{ChatMessage
          id=id
          author=author
          time=time
          isOwn=isOwn
          text=text
          imageUrl=imageUrl
          imageAlt=imageAlt
        }}}
      {{/each}}
    </div>

    {{{MessageForm
      formErrors=../formErrors
      formValues=../formValues
    }}}

    {{#Modal
      id="add-user-modal"
      label="Добавить пользователя"
      isOpen=../isAddUserModalOpen
      onClose=../onAddUserModalClose
    }}
      {{{ChatUserForm
        title=../addUserForm.title
        submitText=../addUserForm.submitText
        action=../addUserForm.action
      }}}
    {{/Modal}}

    {{#Modal
      id="remove-user-modal"
      label="Удалить пользователя"
      isOpen=../isRemoveUserModalOpen
      onClose=../onRemoveUserModalClose
    }}
      {{{ChatUserForm
        title=../removeUserForm.title
        submitText=../removeUserForm.submitText
        action=../removeUserForm.action
      }}}
    {{/Modal}}
  </section>
{{else}}
  <section class="dialog-empty" aria-label="Диалог">
    <p class="dialog-empty__text">Выберите чат, чтобы отправить сообщение</p>
  </section>
{{/with}}
