{{#with activeChat}}
  <section class="dialog" aria-label="Открытый диалог">
    {{{DialogHeader
      title=title
      avatarUrl=avatarUrl
      users=users
      usersError=usersError
      isUsersLoading=isUsersLoading
      chatActionsDropdown=../chatActionsDropdown
      updateAvatarModalId=../updateChatAvatarModalId
      isUpdateAvatarModalOpen=../isUpdateChatAvatarModalOpen
      onUpdateAvatar=../onUpdateChatAvatarModalOpen
      onAddUser=../onAddUserModalOpen
      onRemoveUser=../onRemoveUserModalOpen
    }}}

    <div class="dialog-messages">
      {{#if date}}
        <time class="dialog-date">{{date}}</time>
      {{/if}}

      {{#each messages}}
        {{{ChatMessage
          id=id
          author=author
          time=time
          timestamp=timestamp
          isOwn=isOwn
          deliveryStatus=deliveryStatus
          deliveryStatusLabel=deliveryStatusLabel
          text=text
          imageUrl=imageUrl
          imageAlt=imageAlt
        }}}
      {{/each}}
    </div>

    {{#if connectionError}}
      <p class="dialog-error" role="alert">{{connectionError}}</p>
    {{/if}}

    {{{MessageForm
      formErrors=../formErrors
      formValues=../formValues
      onFileSubmit=../onFileSubmit
      onSubmit=../onMessageSubmit
    }}}

    {{#Modal
      id=../updateChatAvatarModalId
      label="Обновить аватар"
      isOpen=../isUpdateChatAvatarModalOpen
      onClose=../onUpdateChatAvatarModalClose
    }}
      {{{UpdateChatAvatarForm
        title=../updateChatAvatarForm.title
        chatId=id
        avatarUrl=avatarUrl
        onSuccess=../onUpdateChatAvatarModalClose
      }}}
    {{/Modal}}

    {{#Modal
      id=../addUserModalId
      label="Добавить пользователя"
      isOpen=../isAddUserModalOpen
      onClose=../onAddUserModalClose
    }}
      {{{AddUserToChatForm
        title=../addUserForm.title
        submitText=../addUserForm.submitText
        chatId=id
        onSuccess=../onAddUserModalClose
      }}}
    {{/Modal}}

    {{#Modal
      id=../removeUserModalId
      label="Удалить пользователя"
      isOpen=../isRemoveUserModalOpen
      onClose=../onRemoveUserModalClose
    }}
      {{{RemoveUserFromChatForm
        title=../removeUserForm.title
        chatId=id
        users=users
        usersError=usersError
        isUsersLoading=isUsersLoading
        onSuccess=../onRemoveUserModalClose
      }}}
    {{/Modal}}
  </section>
{{else}}
  <section class="dialog-empty" aria-label="Диалог">
    <p class="dialog-empty__text">Выберите чат, чтобы отправить сообщение</p>
  </section>
{{/with}}
