<aside class="chats__sidebar">
  <header class="sidebar-header">
    <div class="sidebar-header__top">
      <button
        class="create-chat-button"
        type="button"
        aria-label="Создать чат"
        aria-controls="{{createChatModalId}}"
        aria-expanded="{{isCreateChatModalOpen}}"
        data-create-chat-trigger
      >
        <svg class="create-chat-button__icon" viewBox="0 0 448 512" aria-hidden="true">
          <path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32v144H48c-17.7 0-32 14.3-32 32s14.3 32 32 32h144v144c0 17.7 14.3 32 32 32s32-14.3 32-32V288h144c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z" />
        </svg>
      </button>

      <a class="profile-link" href="{{profileHref}}">
        Профиль
        <span class="profile-link__arrow" aria-hidden="true"></span>
      </a>
    </div>

    <form class="search-form" action="#" method="get">
      <label class="search-form__label" for="chat-search">Поиск</label>
      {{{Input
        className="search-form__input"
        id="chat-search"
        type="search"
        name="search"
        placeholder=" "
      }}}
      <span class="search-form__placeholder" aria-hidden="true">Поиск</span>
    </form>

    {{#Modal
      id=createChatModalId
      label="Создать чат"
      isOpen=isCreateChatModalOpen
      onClose=onCreateChatModalClose
    }}
      {{{CreateChatForm
        title=createChatForm.title
        submitText=createChatForm.submitText
        onSuccess=onCreateChatSuccess
      }}}
    {{/Modal}}
  </header>

  <nav class="chat-navigation" aria-label="Список чатов">
    <ul class="chat-list">
      {{#each chats}}
        {{{ChatItem
          id=id
          title=title
          avatarUrl=avatarUrl
          isActive=isActive
          unreadCount=unreadCount
          lastMessage=lastMessage
        }}}
      {{else}}
        <li class="chat-list__empty">
          <button
            class="chat-list__empty-button"
            type="button"
            aria-controls="{{createChatModalId}}"
            aria-expanded="{{isCreateChatModalOpen}}"
            data-create-chat-trigger
          >
            Создайте свой первый чат
          </button>
        </li>
      {{/each}}
    </ul>
  </nav>
</aside>
