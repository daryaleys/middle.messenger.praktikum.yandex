<main class="chats">
    {{#if isLoading}}
        <section class="chats-state" aria-live="polite">
            <p class="chats-state__text">Загрузка...</p>
        </section>
    {{else}}
        {{#if error}}
            <section class="chats-state" role="alert">
                <p class="chats-state__text">{{error}}</p>
            </section>
        {{else}}
            {{{SidebarLayout chats=chats}}}
            {{{DialogLayout activeChat=activeChat formErrors=formErrors formValues=formValues}}}
        {{/if}}
    {{/if}}
</main>
